# =============================================================================
# wr3 — environment template
# Copy to .env.local (web) and apps/api/.env (api), fill in values.
# NEVER commit real values. All secrets — through Doppler in prod.
# =============================================================================

# -------- Core --------
NODE_ENV=development
WR3_ENV=local

# -------- Database --------
DATABASE_URL=postgresql://wr3:wr3@localhost:5432/wr3
REDIS_URL=redis://localhost:6379/0

# -------- LLM providers --------
# Primary for security-sensitive (PoC, raw findings) — must support ZDR
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Secondary for UI / coding-glue (cheaper, retention not critical)
NAVYAI_API_KEY=
NAVYAI_BASE_URL=https://api.navy/v1

# Local LLM (Qwen3-Coder via vLLM)
LOCAL_LLM_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct

# Embeddings (Gemini free tier)
GEMINI_API_KEY=

# -------- Knowledge sources --------
SOLODIT_API_KEY=
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=

# -------- RPC providers --------
# Primary
ALCHEMY_API_KEY=
# Fallback (no key needed for public)
RPC_ETH_FALLBACK=https://eth.drpc.org
RPC_BASE_FALLBACK=https://base.drpc.org
RPC_ARB_FALLBACK=https://arb1.arbitrum.io/rpc
RPC_BSC_FALLBACK=https://bsc-dataseed1.binance.org
RPC_SOL_FALLBACK=https://api.mainnet-beta.solana.com

# -------- Auth --------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -------- Payments --------
# USDC EOA address for crypto payments
WR3_RECEIVING_ADDRESS_BASE=
REQUEST_FINANCE_API_KEY=

# Optional MoR fallbacks (not required for MVP)
POLAR_API_KEY=
LEMON_SQUEEZY_API_KEY=

# -------- Telegram --------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TON_CONNECT_MANIFEST_URL=

# -------- Storage --------
# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_REPORTS=wr3-reports

# -------- Monitoring --------
SENTRY_DSN=
UPTIME_ROBOT_API_KEY=

# -------- OpSec --------
# Comma-separated allowlist for findings-bucket access (multisig signers)
WR3_ADMIN_PUBKEYS=
