# Copy to apps/api/.env for local dev
WR3_ENV=local
# Native Postgres (Homebrew on macOS): uses peer auth via current OS user.
DATABASE_URL=postgresql+asyncpg://localhost:5432/wr3
REDIS_URL=redis://localhost:6379/0

OPENROUTER_API_KEY=
NAVYAI_API_KEY=
GEMINI_API_KEY=

ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
ALCHEMY_API_KEY=
SOLODIT_API_KEY=
