# Copy to apps/api/.env for local dev
WR3_ENV=local
# Native Postgres (Homebrew on macOS): uses peer auth via current OS user.
DATABASE_URL=postgresql+asyncpg://localhost:5432/wr3
REDIS_URL=redis://localhost:6379/0

OPENROUTER_API_KEY=
NAVYAI_API_KEY=
GEMINI_API_KEY=

ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
ALCHEMY_API_KEY=
# GoPlus Security — optional, increases rate limit from 30 to 100 req/min.
GOPLUS_API_KEY=
# Public URL of the Mini App / web (Cloudflare Workers deploy). Bot DMs
# use this to link users back from chat. Without it /tg/* links would
# point at the API host and 404.
NEXT_PUBLIC_SITE_URL=
